{
  "name": "acb",
  "version": "0.1.0",
  "private": true,
  "description": "Self-maintaining API dependencies: detect upstream API/SDK changes, judge repository impact, and prepare a migration PR.",
  "type": "module",
  "bin": {
    "acb": "bin/acb"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "acb": "node bin/acb",
    "test": "node --test \"test/*.test.ts\"",
    "demo": "node scripts/demo.ts",
    "demo:clean": "rm -rf .demo",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  }
}
