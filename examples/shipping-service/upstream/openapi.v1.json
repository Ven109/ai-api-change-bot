{
  "openapi": "3.0.3",
  "info": {
    "title": "Parcelio Shipping API",
    "version": "2026-04-01",
    "description": "DEMO FIXTURE. Synthetic provider used to demonstrate acb; modeled on common shipping-API shapes, not a real service."
  },
  "servers": [{ "url": "https://api.parcelio.test" }],
  "paths": {
    "/v1/shipments": {
      "post": {
        "operationId": "createShipment",
        "summary": "Create a shipment",
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/v1/shipments/{shipment_id}": {
      "get": {
        "operationId": "getShipment",
        "summary": "Fetch a shipment",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The shipment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "state": { "type": "string" },
                    "weight_grams": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/shipments/{shipment_id}/track": {
      "get": {
        "operationId": "trackShipment",
        "summary": "Tracking state for a shipment",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "carrier",
            "in": "query",
            "required": false,
            "description": "Carrier slug, for example dhl or ups.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Tracking state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "eta": { "type": "string", "format": "date" },
                    "checkpoints": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "at": { "type": "string", "format": "date-time" },
                          "location": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/labels": {
      "post": {
        "operationId": "createLabel",
        "summary": "Buy a shipping label",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["shipment_id", "weight_grams"],
                "properties": {
                  "shipment_id": { "type": "string" },
                  "weight_grams": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The label",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "label_url": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/returns": {
      "post": {
        "operationId": "createReturn",
        "summary": "Register a return",
        "parameters": [
          {
            "name": "reason",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "201": { "description": "Created" } }
      }
    }
  }
}
